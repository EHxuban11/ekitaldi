generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Gallery {
  id           String         @id @default(cuid())
  name         String
  date         String?
  passwordHash String?        @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  brandingJson String?        @map("branding_json")
  coverPhotoId String?        @map("cover_photo_id")

  // Opt-in face recognition. Existing galleries default to false and keep the
  // exact same render/response path, no regressions. Only galleries published
  // with the --faces pipeline flip this on.
  faceRecognitionEnabled Boolean @default(false) @map("face_recognition_enabled")

  // UI language for the gallery page: "en" (default), "eu" (Basque), "es".
  language String @default("en")

  // Gallery experience: "normal" (default, a flat gallery, unchanged) or
  // "wedding" (rich layout: sections, logo, video, faces). Keeps wedding
  // complexity isolated so normal galleries render exactly as before.
  type    String  @default("normal")
  logoKey String? @map("logo_key") // r2 key of the wedding logo shown in the hero
  slug    String? @unique // pretty URL, e.g. "ainhoa-eta-adrian"; falls back to id

  photos         GalleryPhoto[]
  personClusters PersonCluster[]
  faces          Face[]

  @@map("galleries")
}

model GalleryPhoto {
  id         String  @id @default(cuid())
  galleryId  String  @map("gallery_id")
  r2Key      String  @map("r2_key")
  filename   String
  order      Int
  width      Int?
  height     Int?
  thumbR2Key String  @map("thumb_r2_key")

  // Denormalized list of cluster personIds appearing in this photo (e.g.
  // ["person_001","person_004"]). Empty for non-face galleries. This array is
  // what powers "find me in the photos" filtering in the UI.
  personIds String[] @default([]) @map("person_ids")

  // Wedding-mode grouping. null for normal galleries. Section keys: todas,
  // familia_marco, familia_importante, novios_solos, novios_con_amigos, prints,
  // videos.
  section     String?
  mediaType   String  @default("image") @map("media_type") // "image" | "video"
  posterR2Key String? @map("poster_r2_key") // optional video poster (unused: browser shows first frame)

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  faces   Face[]

  @@map("gallery_photos")
}

// A clustered person within ONE gallery (anonymous: person_001, person_002…).
// Scoped per gallery so personIds never collide across weddings.
model PersonCluster {
  id          String   @id @default(cuid())
  galleryId   String   @map("gallery_id")
  personId    String   @map("person_id") // e.g. "person_001" (person_001 = most photographed)
  size        Int      @default(0) // number of face detections in the cluster
  color       String   @default("#D4D4D4")
  avatarKey   String?  @map("avatar_key") // r2 key of a cropped face thumbnail for the chip
  displayName String?  @map("display_name") // null = anonymous; room for naming later
  exampleKeys String[] @default([]) @map("example_keys") // sample thumb r2 keys (fallback)
  createdAt   DateTime @default(now()) @map("created_at")

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  faces   Face[]

  @@unique([galleryId, personId])
  @@map("person_clusters")
}

// One detected face (bbox + confidence). Stored from the pipeline for future
// bbox overlays; the current UI filters off GalleryPhoto.personIds and does not
// yet render boxes.
model Face {
  id              String   @id @default(cuid())
  galleryId       String   @map("gallery_id")
  photoId         String   @map("photo_id")
  personClusterId String?  @map("person_cluster_id")
  personId        String?  @map("person_id") // denormalized cluster personId, null = noise
  bbox            Json // [x1, y1, x2, y2]
  confidence      Float?
  faceIndex       Int      @map("face_index")
  createdAt       DateTime @default(now()) @map("created_at")

  gallery Gallery        @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo   GalleryPhoto   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  cluster PersonCluster? @relation(fields: [personClusterId], references: [id], onDelete: SetNull)

  @@map("faces")
}
